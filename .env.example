# SQLite file used by Prisma and the better-sqlite3 adapter.
DATABASE_URL="file:./prisma/dev.db"

# IANA zone for "today", due dates, and paid dates.
APP_TIMEZONE="Africa/Lagos"

# Stub payment links stay off unless this is true AND a provider is chosen in Settings.
# Stubs do not call Paystack or Flutterwave, so no secret key is required.
PAYMENT_LINKS_ENABLED="false"

# Optional. Reserved for a future live adapter. The stubs ignore these values.
PAYSTACK_PUBLIC_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
